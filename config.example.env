# ===================================================================
#  openclaw-audit — plik z danymi do audytu jednej maszyny
#  Format: KLUCZ=wartość (jedna na linię, # = komentarz).
#  Plik jest tylko czytany, nigdy wykonywany. Nieznane klucze są błędem.
#  Ścieżki: Windows (D:\...) lub Unix; względne liczone od katalogu tego pliku.
# ===================================================================

# --- Maszyna docelowa (wymagane) ---
AUDIT_HOST=203.0.113.10
AUDIT_PORT=22
AUDIT_USER=azureuser
AUDIT_SSH_KEY=D:\klucze\moj_klucz.pem

# --- Dostęp do modelu ---
#   claude-cli         — używa zalogowanego na maszynie Claude Code (subskrypcja), bez klucza
#   anthropic-api-key  — klucz API Anthropic (z pliku lub wpisany niżej)
AUTH_MODE=claude-cli
# Zalecane: ścieżka do pliku zawierającego wyłącznie klucz API
ANTHROPIC_API_KEY_FILE=
# Alternatywa: klucz wpisany wprost (wtedy chroń ten plik i nie commituj go!)
ANTHROPIC_API_KEY=
# Model (puste = domyślny), np. claude-opus-5-5
AUDIT_MODEL=

# --- Raporty ---
REPORTS_DIR=./reports
AGENT_TIMEOUT=900

# --- Ślad na maszynie ---
# yes = po pobraniu wyników usuń z maszyny wszystko, co zainstalowało narzędzie (~/.openclaw-audit)
# no  = zostaw środowisko (szybszy kolejny audyt); usunięcie później: run-audit.sh --uninstall
CLEANUP=yes

# --- Wersje przypięte (puste = wartości domyślne narzędzia; zmieniaj tylko świadomie) ---
# OpenClaw: zmiana wymaga ponownej oceny skilla i nowego SHA-256 pliku skills/healthcheck/SKILL.md
OPENCLAW_VERSION=
HEALTHCHECK_SHA256=
# Prywatny Node.js pobierany z nodejs.org do ~/.openclaw-audit (systemowy Node nie jest zmieniany);
# sumy z https://nodejs.org/dist/v<wersja>/SHASUMS256.txt dla linux-x64.tar.xz i linux-arm64.tar.xz
NODE_VERSION=
NODE_SHA256_X64=
NODE_SHA256_ARM64=
